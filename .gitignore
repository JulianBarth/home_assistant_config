# Ignore everything by default
*

# Do not ignore these directories
!.gitignore
!*.yaml
!*.md
!*.txt
# Add www directory
!www/   
!tests/
!tests/test_battery_control.py

# Ignore specific files and directories
.storage/
.cloud/
home-assistant_v2.db
.*.log
*.log
.*.db
*.db
secrets.yaml
evcc.yaml

# Diagnostic-safe structured logger and regression tests
!tools/
!tools/battery_log.py
!tests/test_operational_fixes.py
!tests/test_control_edge_cases.py

# Local diagnostics contain private logs and installation snapshots.
diagnostics/
*.tar.gz

# Energy-flow visualization and reproducible preview
!www/energy-flow-card.js
!tests/test_energy_flow.cjs
!previews/
!previews/energy-flow.html

# Dashboard theme and visual regression checks
!themes/
!themes/energy-calm.yaml
!tests/test_dashboard.py

# Reproducible repair for the installed Wattpilot custom integration
!tools/wattpilot-connection-repair.patch
!tools/test_wattpilot_connection.py

# Historical inputs and reproducible model validation
!tools/analyze_usage.py
!tests/test_usage_forecast.py

!tools/seasonal_model.py
!tools/backtest_seasonal_model.py
!tests/test_seasonal_model.py
