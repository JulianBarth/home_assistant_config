# Ignore everything by default
*

# Do not ignore these directories
!.gitignore
!*.yaml
!*.md
!*.txt
# Add www directory
!www/   
!tests/
!tests/test_battery_control.py

# Ignore specific files and directories
.storage/
.cloud/
home-assistant_v2.db
.*.log
*.log
.*.db
*.db
secrets.yaml
evcc.yaml

# Diagnostic-safe structured logger and regression tests
!tools/
!tools/battery_log.py
!tests/test_operational_fixes.py

# Local diagnostics contain private logs and installation snapshots.
diagnostics/
*.tar.gz

# Energy-flow visualization and reproducible preview
!www/energy-flow-card.js
!tests/test_energy_flow.cjs
!previews/
!previews/energy-flow.html

# Dashboard theme and visual regression checks
!themes/
!themes/energy-calm.yaml
!tests/test_dashboard.py
